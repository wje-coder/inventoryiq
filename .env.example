# Copy this file to .env and adjust values for local development.
# Do not commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=inventoryiq
POSTGRES_PASSWORD=inventoryiq
POSTGRES_DB=inventoryiq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=development

# --- Auth / JWT ---
# Required. Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# docker compose will refuse to start the backend if this is left unset.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookies carrying the refresh token are httpOnly always; COOKIE_SECURE
# additionally requires HTTPS. Keep false for local http:// development,
# set true in any deployed/production environment.
COOKIE_SECURE=false
# Comma-separated list of origins allowed to make credentialed requests
# to the backend (must match where the frontend is actually served from).
CORS_ORIGINS=http://localhost:5173

# --- Dataset ingestion ---
# Storage path is hardcoded to /data/datasets inside the backend container
# (backed by the dataset_storage named volume in docker-compose.yml); only
# set DATASET_STORAGE_DIR yourself when running the backend outside Docker.
DATASET_STORAGE_DIR=var/datasets
# Max accepted upload size in bytes. Default is 20MB.
MAX_UPLOAD_SIZE_BYTES=20971520
# Max rows returned by the dataset preview endpoint.
DATASET_PREVIEW_ROW_LIMIT=50

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
